# Where leads come from: "sheets" (production) or "file" (local demo data)
DATA_SOURCE=sheets

# Google Sheet with the leads. The ID is the long part of the sheet URL.
SPREADSHEET_ID=
# Tab the ad integration writes new leads into
LEADS_TAB=PowerLead
# Tab the app creates for comments, calls and emails (lead rows are never edited)
ACTIVITY_TAB=Коментари

# Google service account. Share the sheet with GOOGLE_CLIENT_EMAIL as Editor.
GOOGLE_CLIENT_EMAIL=
# Paste the private_key from the JSON key, with \n kept as literal characters
GOOGLE_PRIVATE_KEY=

# Voice notes: ID of a Google Drive folder INSIDE A SHARED DRIVE (service accounts
# cannot store files in "My Drive"). Add GOOGLE_CLIENT_EMAIL to that shared drive
# as Content manager. Leave empty to switch voice notes off.
VOICE_NOTES_FOLDER_ID=

# Local demo mode only
LOCAL_LEADS_FILE=fixtures/demo-leads.json
LOCAL_ACTIVITY_FILE=.data/activity.json
LOCAL_AUDIO_DIR=.data/audio

# One shared team password (8+ chars). Everyone types their own name at login.
APP_PASSWORD=
# Random string, 32+ chars: openssl rand -base64 48
SESSION_SECRET=

# Email: "off" (only "Open in mail app"), "log" (test, nothing is sent), "smtp" (real sending)
EMAIL_TRANSPORT=off
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
# For Gmail/Workspace: an App Password, not the account password
SMTP_PASS=
EMAIL_FROM="CreateX <leads@example.com>"

# Public URL of the app, used in email links and the agent callback URL
APP_URL=https://createx-leads.vercel.app

# "New lead" emails to the team via Resend (https://resend.com). Empty key = off.
RESEND_API_KEY=
# Comma separated
NOTIFY_EMAIL_TO=
# onboarding@resend.dev works without a verified domain, but only delivers to the Resend account owner
NOTIFY_EMAIL_FROM="CreateX Leads <onboarding@resend.dev>"

# AI calling agent. Every lead from /form is POSTed to this URL. Empty = no automatic calls.
AGENT_WEBHOOK_URL=
# Sent as "Authorization: Bearer <secret>" so the agent can reject strangers
AGENT_WEBHOOK_SECRET=
# The agent sends this as a Bearer token to /api/agent/calls. 24+ chars: openssl rand -hex 24
AGENT_API_KEY=
# Shown as the author of call notes
AGENT_NAME="AI агент"
